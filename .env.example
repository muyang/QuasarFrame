# Copy to .env.local for local development. Never commit real credentials.
DATABASE_URL=./quasarframe.dev.db
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
# Optional: the globe works without Cesium ion terrain.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Comma-separated camera IDs approved for public distribution. Empty by default.
AUTHORIZED_FEED_IDS=
# Exact HTTPS/HTTP origins approved for server-side camera fetching. Empty by default.
FEED_UPSTREAM_ORIGINS=
