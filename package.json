{
  "name": "quasarframe",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test tests/*.test.ts",
    "terrain:validate": "node --import tsx scripts/terrain/validate-views.ts",
    "resource-card:schema": "node --import tsx scripts/generate-resource-card-schema.ts",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx src/db/seed.ts",
    "db:baseline": "node --env-file-if-exists=.env.local --import tsx scripts/baseline-existing-db.ts",
    "images:privatize": "node --import tsx scripts/private-images.ts",
    "db:studio": "drizzle-kit studio",
    "postinstall": "mkdir -p public/cesium && cp -r node_modules/cesium/Build/Cesium/Workers public/cesium/ 2>/dev/null; cp -r node_modules/cesium/Build/Cesium/Assets public/cesium/ 2>/dev/null; cp -r node_modules/cesium/Build/Cesium/Widgets public/cesium/ 2>/dev/null; cp -r node_modules/cesium/Build/Cesium/ThirdParty public/cesium/ 2>/dev/null; true"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cesium": "^1.143.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "flv.js": "^1.6.2",
    "framer-motion": "^12.42.2",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.23.0",
    "mapbox-gl": "^3.25.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "suncalc": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.185.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
